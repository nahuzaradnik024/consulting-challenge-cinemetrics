# Entornos y cachés de Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Secretos
.env

# Datos descargados o generados
# Se versionan solamente las respuestas JSON curadas y los datasets finales
# necesarios para que el equipo trabaje sobre la misma extracción.
data/raw/*
!data/raw/.gitkeep
!data/raw/metadata_*.json
!data/raw/tmdb/
!data/raw/tmdb/*.json
!data/raw/omdb/
!data/raw/omdb/*.json
!data/raw/google_trends/
!data/raw/google_trends/*.csv
data/processed/*
!data/processed/.gitkeep
!data/processed/*.csv

# Archivos del sistema
.DS_Store
Thumbs.db
